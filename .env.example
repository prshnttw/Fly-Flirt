# Copy this file to .env and fill in the values you need. .env is gitignored — never commit real secrets.
# Everything below is read once at startup (flyflirt/config.py); every line here is optional except the
# two under "Required to run at all". Uncomment + edit only what you actually want to change.

# ---- Required to run at all ------------------------------------------------------------
GROQ_API_KEY=                        # from console.groq.com; LLM_API_KEY also works as an alias
SECRET_KEY=                          # any random string locally; MUST be set for APP_ENV=production
                                      # generate one with: openssl rand -hex 32

# ---- Environment -------------------------------------------------------------------------
APP_ENV=development                  # development (default) | production. Also sets the message-text
                                      # retention default — see RETAIN_MESSAGE_TEXT below and the
                                      # Privacy section in README.md.
# PORT=5000
# DATA_DIR=./instance                # where flyflirt.db lives; set to a mounted volume in production
# DB_PATH=                           # overrides DATA_DIR/flyflirt.db entirely if set

# ---- Admin page (/admin) -----------------------------------------------------------------
# Disabled unless BOTH of these are set — leave them blank to keep /admin 404ing. See README.md#admin-page.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# ---- Privacy: does the server keep message text? ------------------------------------------
# Leave unset to get the ENV-based default (production -> no, anything else -> yes). Set explicitly
# to override that default for the whole server; each chat can still override it again for itself
# via the "Save this chat" switch. See README.md#privacy-whats-actually-on-disk.
# RETAIN_MESSAGE_TEXT=true
# RETENTION_DAYS=7                   # how long old chats/reports stay in the database at all

# ---- Cookies / web (set these for a real deployment) ---------------------------------------
# SESSION_COOKIE_SECURE=true         # true once served over HTTPS (Railway/Fly do this by default)
# ALLOWED_ORIGINS=                   # comma-separated list; unset = same-origin only (recommended)
# TRUST_PROXY_HOPS=1                 # number of reverse proxies in front of the app (Railway/Fly = 1)

# ---- Optional "full pathway" bigger brain ---------------------------------------------------
# FULL_ENABLED=true
# FULL_MAX_ROOMS=8                   # concurrent full-pathway rooms; each message costs ~45 ms CPU
# CONNECTOME_FULL_PATH=./static/connectome_full.json

# ---- Matchmaking / room lifecycle ------------------------------------------------------------
# MATCH_TIMEOUT_S=120                # how long to search before suggesting an invite code
# INVITE_TTL_S=1800
# ROOM_IDLE_TTL_S=21600
# IDLE_VERDICT_NUDGE_S=300           # gone quiet for this long in a verdict-ready chat -> nudge banner
# RECONNECT_GRACE_S=25

# ---- Chat limits / rate limiting --------------------------------------------------------------
# MAX_MESSAGE_LEN=400
# MAX_MESSAGES_PER_ROOM=300
# MIN_MESSAGES_FOR_VERDICT=3
# MSG_BURST=4
# MSG_REFILL_PER_S=0.5
# JOIN_BURST=12
# JOIN_REFILL_PER_S=0.2
# CODE_GUESS_BURST=8
# CODE_GUESS_REFILL_PER_S=0.05

# ---- LLM router ---------------------------------------------------------------------------------
# GEMINI_API_KEY=                    # optional extra provider in the fallback chain
# LLM_CHAIN=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,groq:allam-2-7b
# LLM_ENABLED=true                   # set false to force the local heuristic scorer (used by tests)
# LLM_TIMEOUT_S=5
# LLM_TOTAL_BUDGET_S=9
# LLM_MAX_CONCURRENCY=6
# LLM_QUEUE_WAIT_S=0.75
# LLM_QUOTA_MARGIN=0.92

# ---- Simulation tuning (rarely touched — the defaults were fitted deliberately) -----------------
# SIM_GAIN=4.0
# SIM_INPUT_GAIN=1.6
# SIM_THRESHOLD=0.14
# SIM_METER_SCALE=0.107
# SIM_METER_SCALE_FULL=0.079
# SIM_SUBSTEPS=4
# SIM_DECAY_START=0.82
# SIM_DECAY_END=0.95
# SIM_HABITUATION_HALF=14.0
# SIM_ACT_THR=0.10
# SIM_EDGE_THR=0.03
