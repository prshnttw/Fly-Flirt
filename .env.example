# Copy this to .env and fill in your own values. .env is gitignored — never commit real secrets.
# Everything else the app reads has a working default baked into flyflirt/config.py; you only need
# to add more env vars here if you actually want to change one of those defaults.

GROQ_API_KEY=                  # from console.groq.com (LLM_API_KEY also works as the name)
SECRET_KEY=                    # any random string; required once APP_ENV=production
APP_ENV=development            # development | production

# Optional
# GEMINI_API_KEY=             # an extra LLM provider in the fallback chain
# NEUPRINT_TOKEN=             # only needed to run tools/build_connectome.py
# ADMIN_USERNAME=             # both required together to turn on the /admin reports page
# ADMIN_PASSWORD=
